name":"图片","type":"IMAGE","links":null},{"label":"刷新标记","localized_name":"刷新标记","name":"刷新标记","type":"INT","links":null}],"properties":{"cnr_id":"fxai-toolkit","ver":"26c5cb99319cddc11f1045f178b8868d88e7be33","Node name for S&R":"FxAiImageManagerV2","aux_id":"fxai666/fxai-toolkit"},"widgets_values":["avatar",false,""]},{"id":129,"type":"FxaiStoryBoard","pos":[-1990,-330],"size":[1300,1110],"flags":{"collapsed":false,"pinned":true},"order":9,"mode":0,"inputs":[{"localized_name":"刷新标记","name":"刷新标记","shape":7,"type":"INT","link":340},{"localized_name":"lines_data","name":"lines_data","type":"STRING","widget":{"name":"lines_data"},"link":null},{"localized_name":"开始序号","name":"开始序号","shape":7,"type":"INT","widget":{"name":"开始序号"},"link":null},{"localized_name":"结束序号","name":"结束序号","shape":7,"type":"INT","widget":{"name":"结束序号"},"link":null}],"outputs":[{"localized_name":"分镜数据","name":"分镜数据","type":"LIST","links":[356]},{"localized_name":"循环次数","name":"循环次数","type":"INT","links":[342,368]},{"localized_name":"开始索引","name":"开始索引","type":"INT","links":[353]}],"properties":{"cnr_id":"fxai-toolkit","ver":"69ebff1e60b2a71d1bea716c578375e9f9ec86ed","Node name for S&R":"FxaiStoryBoard","aux_id":"fxai666/fxai-toolkit"},"widgets_values":["[{\"提示词\":\"○ 静态构图：书店玻璃门半开，光线逆光涌入，人物立于门框内侧，微微侧身但面部完全朝向镜头。她单手轻扶门框，神情略带恍惚与惊鸿一瞥的凝滞，仿佛在人群中突然定格。浅景深，背景虚化为流动的光斑，人物清晰，米白色裙摆轻垂。\\n\\n\",\"场景道具\":\"0,22\"},{\"提示词\":\"○ 静态构图：人物静立在深色书架间，身体正对镜头，微仰头凝视高处的一本书。双手自然垂落，指尖轻触裙摆。侧面台灯暖光勾勒出清晰的下颌线与鼻梁，眼神眷恋温柔，仿佛在凝视某段记忆。\\n\\n\",\"场景道具\":\"0,22\"},{\"提示词\":\"○ 静态构图：人物侧身立于古旧留声机旁，面部转向镜头，眼神略带寂寥与思念。她右手轻搭在留声机铜喇叭边缘，左手环抱自己。暖黄灯光从下方打亮面部，形成伦勃朗光效，背景书架陷入暗调。\\n\\n\",\"场景道具\":\"0,22\"},{\"提示词\":\"○ 静态构图：人物站在书店拱形窗边，窗外本应是街景，但此刻化成暮色海岸的叠影（双重曝光效果）。她额头轻抵玻璃，面部映在窗上清晰可见，眼神悠远，仿佛穿透时空。光线为冷蓝与暖黄交融。\\n\\n\",\"场景道具\":\"0,22\"},{\"提示词\":\"○ 静态构图：人物赤足站在旧木栈道上，海风吹动长发与裙摆。她面向大海，但转头将面孔留给镜头，眼神坚定而温柔，仿佛在回应前世的约定。远处灯塔光扫过画面，天空是淡紫与灰蓝渐变。\\n\\n\",\"场景道具\":\"1,22\"},{\"提示词\":\"○ 静态构图：人物停在栈道尽头，身体微侧，面部正对镜头回眸。神情温柔而笃定，嘴角似有若无的浅笑。身后是无限延伸的海平线与微弱月光，裙摆被风吹向一侧，构图极具电影感定格。\\n\\n\",\"场景道具\":\"1,22\"},{\"提示词\":\"○ 静态构图：人物站在白色花树下，花瓣零星飘落。她双手轻轻交握于身前，面部抬起沐浴在斑驳树影与柔光中，眼神带着回忆的温暖与淡淡哀愁。晨雾缭绕，画面呈冷白与淡粉色调。\\n\\n\",\"场景道具\":\"2,22\"},{\"提示词\":\"○ 静态构图：人物静坐于青石台阶上，裙摆如云铺开。她双手轻搭膝盖，身体微微前倾，面部正对镜头，眼神深邃仿佛望向内心。背景花树虚化成柔雾，几缕晨光穿透枝桠。\\n\\n\",\"场景道具\":\"2,22\"},{\"提示词\":\"○ 静态构图：人物立于中式月亮门中央，门后是朦胧雾气和远山淡影。她一手轻扶石门，身体正对镜头，神情安然笃定，仿佛在等待一个必然的相遇。光线呈逆光剪影但面部补光清晰。\\n\\n\",\"场景道具\":\"2,22\"},{\"提示词\":\"○ 静态构图：重回书店窗边，但已是夜晚。窗外街灯朦胧，人物面对镜头，背靠窗框，神情比之前更添一丝了悟与宁静。手中多了一本泛黄旧书，抱于胸前。暖黄阅读灯映照半边面容。\\n\\n\",\"场景道具\":\"0,22\"},{\"提示词\":\"○ 静态构图：人物端坐于老木桌前，双臂交叠放在桌面，身体前倾，面孔正对镜头。桌上摊开的书页空白，但她眼神凝聚在虚空，嘴角带一抹释然微笑。台灯光晕笼罩人物。\\n\\n\",\"场景道具\":\"0,22\"},{\"提示词\":\"○ 静态构图：人物斜靠在高耸的书架侧面，一本旧书轻掩在胸口。她微微仰头迎接从上方天窗洒落的月光，面部轮廓被银光勾勒，眼神充满希冀与梦想感。\\n\\n\",\"场景道具\":\"0,22\"},{\"提示词\":\"○ 静态构图：人物站立于墨绿色丝绒沙发旁，手轻搭沙发靠背。面部正对镜头，神情略带疲惫但依旧温柔，眼神仿佛穿越时光凝视某人。沙发旁的落地灯散发暖调光晕。\\n\\n\",\"场景道具\":\"0,22\"},{\"提示词\":\"○ 静态构图：人物蜷坐在沙发角落，真丝裙摆自然垂落地面。她双臂环膝，面孔完整显露，眼神清澈倒映着微光，仿佛在内心看见所念之人。周围环境暗调，仅人物面部被柔光照亮。\\n\\n\",\"场景道具\":\"0,22\"},{\"提示词\":\"○ 静态构图：人物手扶书店玻璃门把，透过玻璃可见门外不是街景，而是海岸与晨曦。她侧身回望镜头，面部表情坚定而永恒，仿佛在说“我一直在”。双重曝光效果，海平线与书架重叠。\\n\\n\",\"场景道具\":\"0,22\"},{\"提示词\":\"○ 静态构图：人物赤足踏在湿润沙滩上，潮水轻触脚踝。她侧身站立，面孔转向镜头，眼神深邃辽远，带着温柔的笃定。晨光从东方破晓，金色与粉紫色晕染天空，人物剪影与清晰面容并存。\\n\\n\",\"场景道具\":\"1,22\"},{\"提示词\":\"○ 静态构图：人物手扶灰白礁石，身体正对镜头，海风将长发与裙摆吹向同一侧。她眼神穿透镜头，直抵人心，凝聚了所有的思念、约定与宁静。背景是壮阔的日出与粼粼波光，画面定格于永恒的诗意瞬间。\\n\\n\",\"场景道具\":\"1,22\"}]",3,3,"",null,null,{"name":"lines_data","value":"[{\"提示词\":\"○ 静态构图：书店玻璃门半开，光线逆光涌入，人物立于门框内侧，微微侧身但面部完全朝向镜头。她单手轻扶门框，神情略带恍惚与惊鸿一瞥的凝滞，仿佛在人群中突然定格。浅景深，背景虚化为流动的光斑，人物清晰，米白色裙摆轻垂。\\n\\n\",\"场景道具\":\"0,22\"},{\"提示词\":\"○ 静态构图：人物静立在深色书架间，身体正对镜头，微仰头凝视高处的一本书。双手自然垂落，指尖轻触裙摆。侧面台灯暖光勾勒出清晰的下颌线与鼻梁，眼神眷恋温柔，仿佛在凝视某段记忆。\\n\\n\",\"场景道具\":\"0,22\"},{\"提示词\":\"○ 静态构图：人物侧身立于古旧留声机旁，面部转向镜头，眼神略带寂寥与思念。她右手轻搭在留声机铜喇叭边缘，左手环抱自己。暖黄灯光从下方打亮面部，形成伦勃朗光效，背景书架陷入暗调。\\n\\n\",\"场景道具\":\"0,22\"},{\"提示词\":\"○ 静态构图：人物站在书店拱形窗边，窗外本应是街景，但此刻化成暮色海岸的叠影（双重曝光效果）。她额头轻抵玻璃，面部映在窗上清晰可见，眼神悠远，仿佛穿透时空。光线为冷蓝与暖黄交融。\\n\\n\",\"场景道具\":\"0,22\"},{\"提示词\":\"○ 静态构图：人物赤足站在旧木栈道上，海风吹动长发与裙摆。她面向大海，但转头将面孔留给镜头，眼神坚定而温柔，仿佛在回应前世的约定。远处灯塔光扫过画面，天空是淡紫与灰蓝渐变。\\n\\n\",\"场景道具\":\"1,22\"},{\"提示词\":\"○ 静态构图：人物停在栈道尽头，身体微侧，面部正对镜头回眸。神情温柔而笃定，嘴角似有若无的浅笑。身后是无限延伸的海平线与微弱月光，裙摆被风吹向一侧，构图极具电影感定格。\\n\\n\",\"场景道具\":\"1,22\"},{\"提示词\":\"○ 静态构图：人物站在白色花树下，花瓣零星飘落。她双手轻轻交握于身前，面部抬起沐浴在斑驳树影与柔光中，眼神带着回忆的温暖与淡淡哀愁。晨雾缭绕，画面呈冷白与淡粉色调。\\n\\n\",\"场景道具\":\"2,22\"},{\"提示词\":\"○ 静态构图：人物静坐于青石台阶上，裙摆如云铺开。她双手轻搭膝盖，身体微微前倾，面部正对镜头，眼神深邃仿佛望向内心。背景花树虚化成柔雾，几缕晨光穿透枝桠。\\n\\n\",\"场景道具\":\"2,22\"},{\"提示词\":\"○ 静态构图：人物立于中式月亮门中央，门后是朦胧雾气和远山淡影。她一手轻扶石门，身体正对镜头，神情安然笃定，仿佛在等待一个必然的相遇。光线呈逆光剪影但面部补光清晰。\\n\\n\",\"场景道具\":\"2,22\"},{\"提示词\":\"○ 静态构图：重回书店窗边，但已是夜晚。窗外街灯朦胧，人物面对镜头，背靠窗框，神情比之前更添一丝了悟与宁静。手中多了一本泛黄旧书，抱于胸前。暖黄阅读灯映照半边面容。\\n\\n\",\"场景道具\":\"0,22\"},{\"提示词\":\"○ 静态构图：人物端坐于老木桌前，双臂交叠放在桌面，身体前倾，面孔正对镜头。桌上摊开的书页空白，但她眼神凝聚在虚空，嘴角带一抹释然微笑。台灯光晕笼罩人物。\\n\\n\",\"场景道具\":\"0,22\"},{\"提示词\":\"○ 静态构图：人物斜靠在高耸的书架侧面，一本旧书轻掩在胸口。她微微仰头迎接从上方天窗洒落的月光，面部轮廓被银光勾勒，眼神充满希冀与梦想感。\\n\\n\",\"场景道具\":\"0,22\"},{\"提示词\":\"○ 静态构图：人物站立于墨绿色丝绒沙发旁，手轻搭沙发靠背。面部正对镜头，神情略带疲惫但依旧温柔，眼神仿佛穿越时光凝视某人。沙发旁的落地灯散发暖调光晕。\\n\\n\",\"场景道具\":\"0,22\"},{\"提示词\":\"○ 静态构图：人物蜷坐在沙发角落，真丝裙摆自然垂落地面。她双臂环膝，面孔完整显露，眼神清澈倒映着微光，仿佛在内心看见所念之人。周围环境暗调，仅人物面部被柔光照亮。\\n\\n\",\"场景道具\":\"0,22\"},{\"提示词\":\"○ 静态构图：人物手扶书店玻璃门把，透过玻璃可见门外不是街景，而是海岸与晨曦。她侧身回望镜头，面部表情坚定而永恒，仿佛在说“我一直在”。双重曝光效果，海平线与书架重叠。\\n\\n\",\"场景道具\":\"0,22\"},{\"提示词\":\"○ 静态构图：人物赤足踏在湿润沙滩上，潮水轻触脚踝。她侧身站立，面孔转向镜头，眼神深邃辽远，带着温柔的笃定。晨光从东方破晓，金色与粉紫色晕染天空，人物剪影与清晰面容并存。\\n\\n\",\"场景道具\":\"1,22\"},{\"提示词\":\"○ 静态构图：人物手扶灰白礁石，身体正对镜头，海风将长发与裙摆吹向同一侧。她眼神穿透镜头，直抵人心，凝聚了所有的思念、约定与宁静。背景是壮阔的日出与粼粼波光，画面定格于永恒的诗意瞬间。\\n\\n\",\"场景道具\":\"1,22\"}]"}]},{"id":24,"type":"UNETLoader","pos":[-2560,-1080],"size":[270,90],"flags":{},"order":6,"mode":0,"inputs":[{"label":"unet_name","localized_name":"UNet名称","name":"unet_name","type":"COMBO","widget":{"name":"unet_name"},"link":null},{"label":"weight_dtype","localized_name":"数据类型","name":"weight_dtype","type":"COMBO","widget":{"name":"weight_dtype"},"link":null}],"outputs":[{"label":"MODEL","localized_name":"模型","name":"MODEL","type":"MODEL","links":[390]}],"properties":{"cnr_id":"comfy-core","ver":"0.18.1","Node name f