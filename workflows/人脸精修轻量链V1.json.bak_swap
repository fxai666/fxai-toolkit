6,1,0.7,0.045,0.85,true,0.3,"自动（按参考图张数）",0,0,0.4,0,42,4,0],"widgets_values_named":{"裁切框边长":0,"超分倍数":4,"超分引擎":"自研超分 (VOSR2)","启用换脸":true,"处理脸宽上限":96,"换脸脸宽上限":96,"换脸强度":1,"遮罩比例":0.7,"羽化半径":0.045,"肤色回拉":0.85,"换脸后二次超分":true,"纹理保留":0.3,"身份锁定方式":"自动（按参考图张数）","锁定帧序号":0,"锁定帧第几张脸":0,"身份相似度阈值":0.4,"修第几张脸":0,"随机种子":42,"批大小":4,"显卡编号":0}},{"id":7,"type":"FxAiTextPreview","pos":[472.0999999999999,659.8999999999999],"size":[430,250],"flags":{},"order":7,"mode":0,"inputs":[{"localized_name":"任意输入","name":"任意输入","type":"*","link":5},{"localized_name":"cache_text","name":"cache_text","type":"STRING","widget":{"name":"cache_text"},"link":null}],"outputs":[],"title":"处理报告（跑了什么、跳过了什么）","properties":{"cnr_id":"fxai-toolkit","ver":"3944422c4d443f30504922a72b986ae812d3ddf5","Node name for S&R":"FxAiTextPreview"},"widgets_values":["参考图序列 2 张\n角色：参考#0（520px）   参考#1（456px）\n没有任何人脸匹配上参考图，已原样返回（当前阈值 0.40，可适当调低）","",{"name":"cache_data","value":"参考图序列 2 张\n角色：参考#0（520px）   参考#1（456px）\n没有任何人脸匹配上参考图，已原样返回（当前阈值 0.40，可适当调低）"}],"widgets_values_named":{"cache_text":"参考图序列 2 张\n角色：参考#0（520px）   参考#1（456px）\n没有任何人脸匹配上参考图，已原样返回（当前阈值 0.40，可适当调低）","text_preview":""}},{"id":5,"type":"FxAiMiniMaxVideoSaveV3","pos":[951.1,76.3],"size":[340,280],"flags":{},"order":6,"mode":0,"inputs":[{"localized_name":"图片序列","name":"图片序列","type":"IMAGE","link":2},{"localized_name":"音频","name":"音频","shape":7,"type":"AUDIO","link":3},{"localized_name":"保存目录","name":"保存目录","type":"STRING","widget":{"name":"保存目录"},"link":null},{"localized_name":"帧率FPS","name":"帧率FPS","type":"FLOAT","widget":{"name":"帧率FPS"},"link":4},{"localized_name":"视频序号","name":"视频序号","type":"INT","widget":{"name":"视频序号"},"link":null}],"outputs":[{"localized_name":"过渡帧","name":"过渡帧","type":"IMAGE","links":[]},{"localized_name":"视频文件路径","name":"视频文件路径","type":"STRING","links":[6]},{"localized_name":"保存目录","name":"保存目录","type":"STRING","links":[]}],"title":"③ 保存成片（音频可选 / 帧率跟随原片）","properties":{"cnr_id":"fxai-toolkit","ver":"3944422c4d443f30504922a72b986ae812d3ddf5","Node name for S&R":"FxAiMiniMaxVideoSaveV3"},"widgets_values":["人脸精修",24,-1],"widgets_values_named":{"保存目录":"人脸精修","帧率FPS":24,"视频序号":-1}},{"id":9,"type":"FxAiVideoPreview","pos":[1337.8000000000002,63.10000000000001],"size":[400,430],"flags":{},"order":8,"mode":0,"inputs":[{"localized_name":"视频文件路径","name":"视频文件路径","type":"STRING","widget":{"name":"视频文件路径"},"link":6}],"outputs":[],"title":"④ 成片预览","properties":{"cnr_id":"fxai-toolkit","ver":"3944422c4d443f30504922a72b986ae812d3ddf5","Node name for S&R":"FxAiVideoPreview"},"widgets_values":["",""],"widgets_values_named":{"视频文件路径":"","video_player":""}},{"id":101,"type":"Note","pos":[-764,34],"size":[760,600],"flags":{},"order":1,"mode":0,"inputs":[],"outputs":[],"title":"使用说明","properties":{"text":""},"widgets_values":["人脸精修 · 轻量链 V1\n=====================================\n\n【这是干什么的】\n只修「糊掉的小脸」：把远景里那几张模糊的脸重建清楚，\n画面其他部分（背景、身体、别人的脸）一律不动。\n\n【怎么跑】\n1. 点 ① 视频加载 上的「📁 选择视频」→ 弹窗里点一下视频 → 双击或点「用完整路径」\n   路径就自动填好了，不用手打\n2. 也能手填：① 视频文件夹路径 填目录 → 视频索引 填第几个；\n   或者直接填视频文件的完整路径（如 I:/ComfyUI/input/xxx.mp4）\n3. 视频索引 默认 -1 = 按上面填的实际路径读（填目录时 -1 等于取第一个）\n4. ① 起始时间 / 结束时间：整片留 0 / 0；长片填 0 / 10 = 只跑前 10 秒\n5. 点运行，成片落在 fxai/video/人脸精修/，右边直接能预览\n\n【这条流没有一个外部节点】\n· 载入：凤希AI - 视频加载（帧 + 帧率 + 音频一次给全）\n· 精修：凤希AI - 人脸精修 · 轻量链\n· 保存：凤希AI - 视频保存V3（音频可选、帧率跟随原片）\n· 预览：凤希AI - 视频预览\n· 参考图：凤希AI - 图像管理器 - 图片加载（填文件夹 + 索引）\n一个 ComfyUI 核心节点、一个第三方节点都没有。\n\n【想只修某一个人】\n左下角「图片加载」填好参考图所在的文件夹和索引，\n把它的「图片」接到精修节点的「参考图」输入上。\n身份锁定方式默认就是「参考图锁定」，接上就只认这个人；\n不接则自动退回「开场锁定主角」，不用手动改。\n接了以后画面里长得不像的人，一帧都不会碰。\n\n【换脸时开场就有好几个人，要指定换哪个】\n开场同框多人时，自动认人会挑面积最大的那个，容易锁错。\n先手动指定一次：\n  1. 身份锁定方式 = 标号预览（看编号再选脸），锁定帧序号 = 0，跑一次\n  2. 会出一张图，每张脸标着编号（0 = 最大的脸），报告里也有文字清单\n  3. 改成 指定帧锁定，锁定帧序号 填刚才的帧号，\n     锁定帧第几张脸 填你要换的那个人的编号\n记住：参考图 = 换成谁，身份锁定 = 视频里换哪个人，是两件事。\n\n【跑完没变化？先看下面的报告】\n· 「清晰跳过 N 帧（脸 ≥ 96px）」= 这段脸本来就不糊，\n  这是设计如此。要强制修就把「处理脸宽上限」调高或设 0。\n· 「命中 0/72 帧」= 参考图里那个人这段里没出现，或阈值太高。\n\n【显存 / 长片】\n整段帧是一次性读进来的，500 帧 1080p 约 12GB。\n整集（1886 帧 1280×768）会吃 20GB+，务必用起止时间分段跑。\n\n"],"widgets_values_named":{"text":"人脸精修 · 轻量链 V1\n=====================================\n\n【这是干什么的】\n只修「糊掉的小脸」：把远景里那几张模糊的脸重建清楚，\n画面其他部分（背景、身体、别人的脸）一律不动。\n\n【怎么跑】\n1. 点 ① 视频加载 上的「📁 选择视频」→ 弹窗里点一下视频 → 双击或点「用完整路径」\n   路径就自动填好了，不用手打\n2. 也能手填：① 视频文件夹路径 填目录 → 视频索引 填第几个；\n   或者直接填视频文件的完整路径（如 I:/ComfyUI/input/xxx.mp4）\n3. 视频索引 默认 -1 = 按上面填的实际路径读（填目录时 -1 等于取第一个）\n4. ① 起始时间 / 结束时间：整片留 0 / 0；长片填 0 / 10 = 只跑前 10 秒\n5. 点运行，成片落在 fxai/video/人脸精修/，右边直接能预览\n\n【这条流没有一个外部节点】\n· 载入：凤希AI - 视频加载（帧 + 帧率 + 音频一次给全）\n· 精修：凤希AI - 人脸精修 · 轻量链\n· 保存：凤希AI - 视频保存V3（音频可选、帧率跟随原片）\n· 预览：凤希AI - 视频预览\n· 参考图：凤希AI - 图像管理器 - 图片加载（填文件夹 + 索引）\n一个 ComfyUI 核心节点、一个第三方节点都没有。\n\n【想只修某一个人】\n左下角「图片加载」填好参考图所在的文件夹和索引，\n把它的「图片」接到精修节点的「参考图」输入上。\n身份锁定方式默认就是「参考图锁定」，接上就只认这个人；\n不接则自动退回「开场锁定主角」，不用手动改。\n接了以后画面里长得不像的人，一帧都不会碰。\n\n【换脸时开场就有好几个人，要指定换哪个】\n开场同框多人时，自动认人会挑面积最大的那个，容易锁错。\n先手动指定一次：\n  1. 身份锁定方式 = 标号预览（看编号再选脸），锁定帧序号 = 0，跑一次\n  2. 会出一张图，每张脸标着编号（0 = 最大的脸），报告里也有文字清单\n  3. 改成 指定帧锁定，锁定帧序号 填刚才的帧号，\n     锁定帧第几张脸 填你要换的那个人的编号\n记住：参考图 = 换成谁，身份锁定 = 视频里换哪个人，是两件事。\n\n【跑完没变化？先看下面的报告】\n· 「清晰跳过 N 帧（脸 ≥ 96px）」= 这段脸本来就不糊，\n  这是设计如此。要强制修就把「处理脸宽上限」调高或设 0。\n· 「命中 0/72 帧」= 参考图里那个人这段里没出现，或阈值太高。\n\n【显存 / 长片】\n整段帧是一次性读进来的，500 帧 1080p 约 12GB。\n整集（1886 帧 1280×768）会吃 20GB+，务必用起止时间分段跑。\n\n"},"color":"#432","bgcolor":"#653"},{"id":102,"type":"Note","pos":[930,540],"size":[560,520],"flags":{},"order":2,"mode":0,"inputs":[],"outputs":[],"title":"参数怎么调","properties":{"text":""},"widgets_values":["参数怎么调\n=====================================\n\n只精修（默认，推荐）\n  启用换脸      = 关\n  身份锁定方式  = 参考图锁定（接了参考图就认图里那个人，\n                  没接则自动退回「开场锁定主角」）\n  开场多人要指定换谁 → 先「标号预览」看编号，再「指定帧锁定」\n  处理脸宽上限  = 96\n  → 只把参考图那个人的糊脸修清楚，人还是本人\n\n要换成另一个人\n  启用换脸      = 开\n  处理脸宽上限  = 0     ← 必须\n  换脸脸宽上限  = 0     ← 必须\n  肤色回拉      = 0.5\n  ⚠ 换脸只有 128px 工作台，清晰脸换完反而掉锐度 −22%，\n    只在「糊到看不出是谁」时才换。\n\n多人各修各的\n  参考图        = 拼成一段图片序列（Image Batch）\n  身份锁定方式  = 多参考分别匹配\n\n保存节点（视频保存V3）\n  保存目录      = 人脸精修（fxai/video/ 下的子目录）\n  帧率FPS       = 接原片帧率（已接好，不用手填）\n  音频          = 接上就带音轨，不接就无声视频\n  视频序号      = -1 时间戳命名，不会覆盖老片\n\n两个硬约束\n  · 裁切框边长 × 超分倍数 必须 = 512\n    （0 = 自动配套，手填只认 128×4 / 256×2 / 512×1）\n  · 脸在裁切框里占比要够，所以框按「目标脸自己的宽度」算，\n    不要按全片最大的脸算。"],"widgets_values_named":{"text":"参数怎么调\n=====================================\n\n只精修（默认，推荐）\n  启用换脸      = 关\n  身份锁定方式  = 参考图锁定（接了参考图就认图里那个人，\n                  没接则自动退回「开场锁定主角」）\n  开场多人要指定换谁 → 先「标号预览」看编号，再「指定帧锁定」\n  处理脸宽上限  = 96\n  → 只把参考图那个人的糊脸修清楚，人还是本人\n\n要换成另一个人\n  启用换脸      = 开\n  处理脸宽上限  = 0     ← 必须\n  换脸脸宽上限  = 0     ← 必须\n  肤色回拉      = 0.5\n  ⚠ 换脸只有 128px 工作台，清晰脸换完反而掉锐度 −22%，\n    只在「糊到看不出是谁」时才换。\n\n多人各修各的\n  参考图        = 拼成一段图片序列（Image Batch）\n  身份锁定方式  = 多参考分别匹配\n\n保存节点（视频保存V3）\n  保存目录      = 人脸精修（fxai/video/ 下的子目录）\n  帧率FPS       = 接原片帧率（已接好，不用手填）\n  音频          = 接上就带音轨，不接就无声视频\n  视频序号      = -1 时间戳命名，不会覆盖老片\n\n两个硬约束\n  · 裁切框边长 × 超分倍数 必须 = 512\n    （0 = 自动配套，手填只认 128×4 / 256×2 / 512×1）\n  · 脸在裁切框里占比要够，所以框按「目标脸自己的宽度」算，\n    不要按全片最大的脸算。"},"color":"#432","bgcolor":"#653"},{"id":103,"type":"Note","pos":[16.338842975206838,826.6694214876037],"size":[400.72727272727275,256.7190082644629],"flags":{},"order":3,"mode":0,"inputs":[],"outputs":[],"title":"参考图这一路","properties":{"text":""},"widgets_values":["参考图这一路\n=====================================\n\n· 接 1 张 = 只认这个人（身份锁定方式默认就是「参考图锁定」）\n· 接一组图（Image Batch 拼起来）+ 选「多参考分别匹配」\n  = 画面里谁像谁就修谁\n· 整条线删掉 = 自动退回「开场锁定主角」，\n  只修全片第一个出现的那个人（参数不用动）\n· 开场多人、要指定换哪一个：\n  先用「标号预览（看编号再选脸）」跑一次看编号，\n  再改成「指定帧锁定」，把编号填进 锁定帧第几张脸\n\n参考图只要脸看得清就行，尺寸、比例不用和原片一致。"],"widgets_values_named":{"text":"参考图这一路\n=====================================\n\n· 接 1 张 = 只认这个人（身份锁定方式默认就是「参考图锁定」）\n· 接一组图（Image Batch 拼起来）+ 选「多参考分别匹配」\n  = 画面里谁像谁就修谁\n· 整条线删掉 = 自动退回「开场锁定主角」，\n  只修全片第一个出现的那个人（参数不用动）\n· 开场多人、要指定换哪一个：\n  先用「标号预览（看编号再选脸）」跑一次看编号，\n  再改成「指定帧锁定」，把编号填进 锁定帧第几张脸\n\n参考图只要脸看得清就行，尺寸、比例不用和原片一致。"},"color":"#432","bgcolor":"#653"},{"id":104,"type":"FxAiCharacterImageSelector","pos":[49.673708080377295,530.5748485429773],"size":[221.6333984375,213.4731273252662],"flags":{},"order":4,"mode":0,"inputs":[{"localized_name":"图片列表","name":"图片列表","type":"STRING","widget":{"name":"图片列表"},"link":null}],"outputs":[{"localized_name":"图片列表","name":"图片列表","type":"IMAGE","links":[7]},{"localized_name":"总数量","name":"总数量","type":"INT","links":[]}],"properties":{"cnr_id":"fxai-toolkit","ver":"269827a81a78bad385e5484fb96c2e16919baf40","Node name for S&R":"FxAiCharacterImageSelector"},"widgets_values":["avatar/000.png,avatar/001.png",""],"widgets_values_named":{"图片列表":"avatar/000.png,avatar/001.png","preview_wrapper":""}}],"links":[[1,1,0,4,0,"IMAGE"],[2,4,0,5,0,"IMAGE"],[3,1,6,5,1,"AUDIO"],[5,4,1,7,0,"STRING"],[6,5,1,9,0,"STRING"],[4,1,4,5,3,"FLOAT"],[7,104,0,4,1,"IMAGE"]],"groups":[{"id":1,"title":"① 输入：原片 + 参考图","bounding":[20,0,410,780],"color":"#3f789e","flags":{}},{"id":2,"title":"② 精修（凤希AI 轻量链，不加载任何大模型）","bounding":[440,0,471.1999999999998,942],"color":"#3f7943","flags":{}},{"id":3,"title":"③ 保存 + 预览（凤希AI 自家节点）","bounding":[930,0,830,500],"color":"#b58b2a","flags":{}}],"config":{},"extra":{"ds":{"scale":1.1,"offset":[176.48956464689462,159.6364241842955]},"frontendVersion":"1.55.18"},"version":0.4}