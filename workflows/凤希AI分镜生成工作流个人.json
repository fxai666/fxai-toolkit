"links":[274,276]},{"label":"刷新标记","localized_name":"刷新标记","name":"刷新标记","type":"INT","links":null}],"properties":{"aux_id":"fxai666/fxai-toolkit","ver":"f4cf63b648727593ee3395006a13b48954b72369","Node name for S&R":"FxAiImageManagerV2","ue_properties":{"widget_ue_connectable":{},"input_ue_unconnectable":{},"version":"7.8"}},"widgets_values":["sex01",""]},{"id":50,"type":"PrimitiveStringMultiline","pos":[-1988.1615043576064,-634.2395820891053],"size":[527.5215974239129,305.2395918942833],"flags":{"collapsed":false},"order":10,"mode":0,"inputs":[{"label":"value","localized_name":"值","name":"value","type":"STRING","widget":{"name":"value"},"link":null}],"outputs":[{"label":"STRING","localized_name":"字符串","name":"STRING","type":"STRING","links":[316]}],"title":"通用提示词","properties":{"cnr_id":"comfy-core","ver":"0.18.1","Node name for S&R":"PrimitiveStringMultiline","ue_properties":{"widget_ue_connectable":{},"input_ue_unconnectable":{},"version":"7.8"}},"widgets_values":["\n镜头要求：男性第一人称POV视角拍摄，镜头紧贴女人身体，画面下方是女人的大腿根部、阴部和臀部，紧贴镜头边缘，占据画面下半部分。\n\n\nnsfw,vagina,clothes_remover,remover_clothes，裸体,脱光衣服。\n\n严格遵循参考图长相：五官精致柔和，皮肤白皙通透，黑色长发柔顺微卷及腰，刘海轻薄隐约露出额头，妆容清透但唇色为豆沙玫瑰色。身材火辣，胸部丰满，乳房D罩杯，曲线紧致。\n\n一间30平方米的超大私人书房。整体干净明亮，极简现代中式融合风格。墙面为淡奶油色，地面是浅橡木色人字拼地板。左侧是一整面顶天立地的开放式胡桃木书架，整齐摆满艺术画册和文学经典，书架角落放着一盏黄铜可调节阅读灯。右侧墙面挂着一幅抽象淡彩水墨画，下方摆放一张灰色亚麻布艺单人沙发，旁边立着一株琴叶榕。中央区域较为空旷，正对镜头的是宽大的实木书桌（桌面仅有一台银色笔记本电脑、一支白色陶瓷花瓶插着三两支雪柳）。书桌后方是落地窗，挂着半透明亚麻纱帘，自然光柔和洒入。天花板有简约轨道射灯。整个空间只出现上述物品，无杂饰，氛围知性且宁静，与热舞形成反差。\n"]},{"id":115,"type":"FxAiMultiLineText","pos":[-2006.8901738888162,-282.64110687050413],"size":[1336.8305780105825,1032.7974446476533],"flags":{},"order":12,"mode":0,"inputs":[{"label":"刷新标记","localized_name":"刷新标记","name":"刷新标记","shape":7,"type":"INT","link":283},{"label":"lines_data","localized_name":"lines_data","name":"lines_data","type":"STRING","widget":{"name":"lines_data"},"link":null},{"label":"开始序号","localized_name":"开始序号","name":"开始序号","shape":7,"type":"INT","widget":{"name":"开始序号"},"link":null},{"label":"结束序号","l