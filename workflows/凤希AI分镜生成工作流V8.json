lags":{},"order":16,"mode":0,"inputs":[{"dir":3,"label":"model","name":"model","type":"MODEL","link":391},{"dir":3,"label":"clip","name":"clip","type":"CLIP","link":189}],"outputs":[{"dir":4,"label":"MODEL","name":"MODEL","shape":3,"type":"MODEL","links":[224]},{"dir":4,"label":"CLIP","name":"CLIP","shape":3,"type":"CLIP","links":[375]}],"properties":{"cnr_id":"rgthree-comfy","ver":"1.0.2604070017","Show Strengths":"Single Strength","Match":"","ue_properties":{"widget_ue_connectable":{},"input_ue_unconnectable":{},"version":"7.8"}},"widgets_values":[{},{"type":"PowerLoraLoaderHeaderWidget"},{"on":true,"lora":"Qwen-Image-Edit-2511-Lightning-8steps-V1.0-bf16.safetensors","strength":1,"strengthTwo":null},{"on":true,"lora":"Qwen-Image-Edit-2511-Cinematic.safetensors","strength":0.7,"strengthTwo":null},{"on":true,"lora":"Kook_Qwen_V3极致真实.safetensors","strength":0.7,"strengthTwo":null},{"on":true,"lora":"qwen-image-edit-2511-multiple-angles-lora.safetensors","strength":0.3,"strengthTwo":null},{"on":true,"lora":"PixelSmile-preview.safetensors","strength":0.5,"strengthTwo":null},{"on":true,"lora":"qwen_realistic_skin.safetensors","strength":0.5,"strengthTwo":null},{},""]},{"id":117,"type":"FxAiImageManagerV2","pos":[-670,-330],"size":[860,670],"flags":{"collapsed":false,"pinned":true},"order":26,"mode":0,"inputs":[{"label":"图片","localized_name":"图片","name":"图片","shape":7,"type":"IMAGE","link":303},{"label":"刷新标记","localized_name":"刷新标记","name":"刷新标记","shape":7,"type":"INT","link":null},{"label":"文件名序号","localized_name":"文件名序号","name":"文件名序号","shape":7,"type":"INT","link":361},{"label":"目录","localized_name":"目录","name":"目录","type":"STRING","widget":{"name":"目录"},"link":null},{"localized_name":"启用文件名覆盖","name":"启用文件名覆盖","shape":7,"type":"BOOLEAN","widget":{"name":"启用文件名覆盖"},"link":null}],"outputs":[{"label":"文件夹路径","localized_name":"文件夹路径","name":"文件夹路径","type":"STRING","links":null},{"label":"图片总数","localized_name":"图片总数","name":"图片总数","type":"INT","links":null},{"label":"图片","localized_name":"图片","name":"图片","type":"IMAGE","links":[306,307]},{"label":"刷新标记","localized_name":"刷新标记","name":"刷新标记","type":"INT","links":null}],"properties":{"cnr_id":"fxai-toolkit","ver":"ed1b5a241e9f5630b9bb3cb84956d51f45a84840","Node name for S&R":"FxAiImageManagerV2","aux_id":"fxai666/fxai-toolkit","ue_properties":{"widget_ue_connectable":{},"input_ue_unconnectable":{},"version":"7.8"}},"widgets_values":["故事里的事",true,""]},{"id":129,"type":"FxaiStoryBoard","pos":[-1990,-330],"size":[1300,1110],"flags":{"collapsed":false,"pinned":true},"order":9,"mode":0,"inputs":[{"localized_name":"刷新标记","name":"刷新标记","shape":7,"type":"INT","link":340},{"localized_name":"lines_data","name":"lines_data","type":"STRING","widget":{"name":"lines_data"},"link":null},{"localized_name":"开始序号","name":"开始序号","shape":7,"type":"INT","widget":{"name":"开始序号"},"link":null},{"localized_name":"结束序号","name":"结束序号","shape":7,"type":"INT","widget":{"name":"结束序号"},"link":null}],"outputs":[{"localized_name":"分镜数据","name":"分镜数据","type":"LIST","links":[356]},{"localized_name":"循环次数","name":"循环次数","type":"INT","links":[342,368]},{"localized_name":"开始索引","name":"开始索引","type":"INT","links":[353]}],"properties":{"cnr_id":"fxai-toolkit","ver":"69ebff1e60b2a71d1bea716c578375e9f9ec86ed","Node name for S&R":"FxaiStoryBoard","aux_id":"fxai666/fxai-toolkit"},"widgets_values":["[{\"提示词\":\"静态构图描述：中景，人物侧身倚靠在巨大的胡桃木书柜旁，右手手肘轻搭在一排旧书脊上，左手自然垂落，指尖轻轻触碰书脊。面部正对镜头，眼神低垂看向书桌上那本摊开的泛黄手写本，神情宁静而若有所思，仿佛在倾听遥远的讲述。暖金色斜阳从左侧窗户洒入，打在人物半边脸上，形成柔和的明暗过渡，发丝边缘泛起金色轮廓光。空气中可见细细的尘埃缓慢漂浮。画面景深较浅，背景书柜略微虚化，突出人物神态与旧书质感。\\n\\n\",\"场景道具\":\"0,14\"},{\"提示词\":\"静态构图描述：近景，人物坐在红木书桌前，身体微微前倾，右手执一支老式钢笔悬在故事本上方，笔尖未落。左手平放在泛黄的纸页上，指尖微微施力压住页角。面部正对镜头，抬眸直视，眼神中带着一丝探究与思辨，仿佛在辨别故事中的善恶真假。台灯的翡翠绿玻璃罩将暖黄光线聚拢在纸面，人物脸部受光均匀柔和，背景书柜完全虚化为深棕色光斑。画面氛围沉静而富有张力，色彩饱和度略低，呈现胶片质感。\\n\\n\",\"场景道具\":\"0,14\"},{\"提示词\":\"静态构图描述：中全景，人物从书桌前起身，走向角落的留声机，身体面向留声机但面部转回朝向镜头，呈现一个回头凝望的姿态。右手抬起即将触碰留声机的铜喇叭，指尖距喇叭仅几厘米。面部神情带着一丝困惑与自省，眉心微蹙但嘴角有浅淡笑意。整个书房空间呈现于画面中，光影层次丰富：书桌区亮暖，留声机角落稍暗，形成明暗对话。窗帘被微风拂动一角，些许阳光透入在地毯上形成晃动的光斑。\\n\\n\",\"场景道具\":\"0,14\"},{\"提示词\":\"静态构图描述：场景切换至老庭院。人物坐在红漆门廊下的藤编椅子上，身体后靠，双腿自然交叠，双手捧着一只粗陶茶杯置于膝上。面部正对镜头，阳光透过老槐树叶在人物脸上投下斑驳摇曳的光斑，眼神望向远方，瞳孔中映着树影，神情似笑非笑，带着对“说是就是”的玩味与释然。身后是斑驳的红漆木门，门环上的铜锈清晰可见。老槐树的枝叶在画面顶部形成天然画框，地面上有几片枯叶静止。整体色调暖黄与灰绿交织，充满怀旧电影感。\\n\\n\",\"场景道具\":\"1,14\"},{\"提示词\":\"静态构图描述：中景，人物从藤椅上起身，站在红漆斑驳的木门前，正面朝向镜头，右手指尖轻轻抚过门板上剥落的漆皮痕迹，左手自然垂在身侧。面部神情平静如水，眼神低垂看着指尖触碰的木头纹理，嘴角抿着一抹意味深长的淡笑，仿佛在触摸时光中“不是”的那一面。阳光从斜后方打来，人物身体边缘形成柔和的轮廓光，面部受光均匀柔和。身后庭院景深虚化，只见光斑与树影婆娑。\\n\\n\",\"场景道具\":\"14,1\"},{\"提示词\":\"静态构图描述：场景切换至迷雾之境。人物站在镜像般的水面上，水面极浅仅及鞋底，倒映出清晰的倒影。背景是层层白纱帷幕，从实体逐渐虚化融入远处的柔光中。人物身着同样的羊绒衫与阔腿裤，站姿端正，双手在身前自然交叠，面部朝向镜头，眼神通透而平静，仿佛已看透故事的真假虚实。薄雾在人物周身缓慢流动，几缕雾气拂过衣摆。色调为极低饱和的米白、浅灰与淡金，画面极简而富有禅意，人物是唯一的实体焦点。\\n\\n\",\"场景道具\":\"2,14\"},{\"提示词\":\"静态构图描述：中近景，人物保持右手掌心向上的姿态，但左手已抬起轻覆在右手之上，形成一个“合掌但未合拢”的手势，双手之间留有虚空。面部正对镜头，眼神深邃而柔和，嘴唇微启，仿佛刚说完“不是”二字，神态中带着哲思后的豁达。身后的白纱帷幕有一层被微风吹起，在人物身后形成柔美的弧线。雾气浓度略增，人物的倒影在水中变得略微模糊，象征虚实边界进一步消融。光影偏冷白，带一点极淡的蓝调。\\n\\n\",\"场景道具\":\"2,14\"},{\"提示词\":\"静态构图描述：场景回归老旧书房。中景，人物站在书房的窗边，身体侧对窗户但面部转向镜头，右手抬起轻轻拉开墨绿色丝绒窗帘的一角，让更多金色阳光涌入。阳光瞬间照亮人物半边脸颊和脖颈，瞳孔中映出窗外的天光。左手持着那本泛黄的故事本贴在胸前。眼神直视镜头，带着一种“或许这就是真实”的温和笃定。背景书柜和留声机在逆光中呈现深沉的剪影感，尘埃在涌入的光柱中热烈飞舞。画面光影对比强烈，色调从冷白过渡回暖金。\\n\\n\",\"场景道具\":\"0,14\"},{\"提示词\":\"静态构图描述：近景，人物重新坐回书桌前，双手将故事本轻轻合上，手掌平压在封面上。身体微微前倾，下巴轻搁在交叠的手背上，面部正面朝向镜头，距离较近，五官清晰，眼神中带着一丝俏皮的疑问与看破后的轻盈，嘴角微扬。台灯的翡翠绿灯罩在人物眼中形成两个小小的绿色光点。画面景深极浅，焦点全在人物面部和故事本封面，背景完全虚化成一团暖棕色的光晕。书页间夹着的一片干枯银杏叶露出一角。氛围亲密而安静。\\n\\n\",\"场景道具\":\"14,0\"},{\"提示词\":\"静态构图描述：全景，人物站立在书柜与桌子之间，踮起脚尖将故事本插回书柜高处的一个空格中，左臂伸直推送书本，右臂自然下垂。身体右转但面部完全转向镜头，呈现一个舒展的回眸姿态。眼神清澈坦然，仿佛完成了一场仪式，神情平静中带有满足。整个书房空间完整呈现：书桌、台灯、留声机、窗帘、地毯、窗户，所有元素和谐共存。阳光已转为更浓郁的琥珀色，长长的影子投射在地毯上，书房笼罩在黄昏的宁静中。画面具有电影结尾的定格感。\\n\\n\",\"场景道具\":\"14,0\"},{\"提示词\":\"静态构图描述：中近景，人物站在留声机旁，右手食指轻点在静止的黑胶唱片中央标签上，左手扶在桌沿。身体前倾但面部抬起朝向镜头，眼神深邃而温柔，嘴角绽放一个完整的、释然的微笑，这是全片中最温暖的表情。翡翠台灯的光和窗外黄昏余晖在人物脸上交汇，形成冷暖交织的肤色质感。留声机的铜喇叭上映出人物缩小而变形的倒影。空气中尘埃几乎静止，氛围达到最静谧的高潮。画面色彩饱和略提升，金色的暖调贯穿始终。\\n\\n\",\"场景道具\":\"0,14\"},{\"提示词\":\"静态构图描述：全景，人物站在书房中央，身后是书柜、书桌、留声机，面前是镜头。站姿放松自然，双手垂在身侧，面部完全朝向镜头，眼神宁静如深潭，嘴角仍挂着那个释然的微笑。台灯是此刻唯一的光源，在人物身上投下温暖的光晕，身体一侧被照亮，另一侧融入柔和的暗影中，明暗交界线柔和。整个书房在暗影中呈现深沉的木色，只有人物和台灯光是画面的暖色焦点。故事本静静立在书架的格子里，留声机静止。画面如同一幅古典油画，充满寂静的故事感。气氛归于圆满的宁静。\\n\\n\",\"场景道具\":\"0,14\"}]",10,10,"",null,null,{"name":"lines_data","value":"[{\"提示词\":\"静态构图描述：中景，人物侧身倚靠在巨大的胡桃木书柜旁，右手手肘轻搭在一排旧书脊上，左手自然垂落，指尖轻轻触碰书脊。面部正对镜头，眼神低垂看向书桌上那本摊开的泛黄手写本，神情宁静而若有所思，仿佛在倾听遥远的讲述。暖金色斜阳从左侧窗户洒入，打在人物半边脸上，形成柔和的明暗过渡，发丝边缘泛起金色轮廓光。空气中可见细细的尘埃缓慢漂浮。画面景深较浅，背景书柜略微虚化，突出人物神态与旧书质感。\\n\\n\",\"场景道具\":\"0,14\"},{\"提示词\":\"静态构图描述：近景，人物坐在红木书桌前，身体微微前倾，右手执一支老式钢笔悬在故事本上方，笔尖未落。左手平放在泛黄的纸页上，指尖微微施力压住页角。面部正对镜头，抬眸直视，眼神中带着一丝探究与思辨，仿佛在辨别故事中的善恶真假。台灯的翡翠绿玻璃罩将暖黄光线聚拢在纸面，人物脸部受光均匀柔和，背景书柜完全虚化为深棕色光斑。画面氛围沉静而富有张力，色彩饱和度略低，呈现胶片质感。\\n\\n\",\"场景道具\":\"0,14\"},{\"提示词\":\"静态构图描述：中全景，人物从书桌前起身，走向角落的留声机，身体面向留声机但面部转回朝向镜头，呈现一个回头凝望的姿态。右手抬起即将触碰留声机的铜喇叭，指尖距喇叭仅几厘米。面部神情带着一丝困惑与自省，眉心微蹙但嘴角有浅淡笑意。整个书房空间呈现于画面中，光影层次丰富：书桌区亮暖，留声机角落稍暗，形成明暗对话。窗帘被微风拂动一角，些许阳光透入在地毯上形成晃动的光斑。\\n\\n\",\"场景道具\":\"0,14\"},{\"提示词\":\"静态构图描述：场景切换至老庭院。人物坐在红漆门廊下的藤编椅子上，身体后靠，双腿自然交叠，双手捧着一只粗陶茶杯置于膝上。面部正对镜头，阳光透过老槐树叶在人物脸上投下斑驳摇曳的光斑，眼神望向远方，瞳孔中映着树影，神情似笑非笑，带着对“说是就是”的玩味与释然。身后是斑驳的红漆木门，门环上的铜锈清晰可见。老槐树的枝叶在画面顶部形成天然画框，地面上有几片枯叶静止。整体色调暖黄与灰绿交织，充满怀旧电影感。\\n\\n\",\"场景道具\":\"1,14\"},{\"提示词\":\"静态构图描述：中景，人物从藤椅上起身，站在红漆斑驳的木门前，正面朝向镜头，右手指尖轻轻抚过门板上剥落的漆皮痕迹，左手自然垂在身侧。面部神情平静如水，眼神低垂看着指尖触碰的木头纹理，嘴角抿着一抹意味深长的淡笑，仿佛在触摸时光中“不是”的那一面。阳光从斜后方打来，人物身体边缘形成柔和的轮廓光，面部受光均匀柔和。身后庭院景深虚化，只见光斑与树影婆娑。\\n\\n\",\"场景道具\":\"14,1\"},{\"提示词\":\"静态构图描述：场景切换至迷雾之境。人物站在镜像般的水面上，水面极浅仅及鞋底，倒映出清晰的倒影。背景是层层白纱帷幕，从实体逐渐虚化融入远处的柔光中。人物身着同样的羊绒衫与阔腿裤，站姿端正，双手在身前自然交叠，面部朝向镜头，眼神通透而平静，仿佛已看透故事的真假虚实。薄雾在人物周身缓慢流动，几缕雾气拂过衣摆。色调为极低饱和的米白、浅灰与淡金，画面极简而富有禅意，人物是唯一的实体焦点。\\n\\n\",\"场景道具\":\"2,14\"},{\"提示词\":\"静态构图描述：中近景，人物保持右手掌心向上的姿态，但左手已抬起轻覆在右手之上，形成一个“合掌但未合拢”的手势，双手之间留有虚空。面部正对镜头，眼神深邃而柔和，嘴唇微启，仿佛刚说完“不是”二字，神态中带着哲思后的豁达。身后的白纱帷幕有一层被微风吹起，在人物身后形成柔美的弧线。雾气浓度略增，人物的倒影在水中变得略微模糊，象征虚实边界进一步消融。光影偏冷白，带一点极淡的蓝调。\\n\\n\",\"场景道具\":\"2,14\"},{\"提示词\":\"静态构图描述：场景回归老旧书房。中景，人物站在书房的窗边，身体侧对窗户但面部转向镜头，右手抬起轻轻拉开墨绿色丝绒窗帘的一角，让更多金色阳光涌入。阳光瞬间照亮人物半边脸颊和脖颈，瞳孔中映出窗外的天光。左手持着那本泛黄的故事本贴在胸前。眼神直视镜头，带着一种“或许这就是真实”的温和笃定。背景书柜和留声机在逆光中呈现深沉的剪影感，尘埃在涌入的光柱中热烈飞舞。画面光影对比强烈，色调从冷白过渡回暖金。\\n\\n\",\"场景道具\":\"0,14\"},{\"提示词\":\"静态构图描述：近景，人物重新坐回书桌前，双手将故事本轻轻合上，手掌平压在封面上。身体微微前倾，下巴轻搁在交叠的手背上，面部正面朝向镜头，距离较近，五官清晰，眼神中带着一丝俏皮的疑问与看破后的轻盈，嘴角微扬。台灯的翡翠绿灯罩在人物眼中形成两个小小的绿色光点。画面景深极浅，焦点全在人物面部和故事本封面，背景完全虚化成一团暖棕色的光晕。书页间夹着的一片干枯银杏叶露出一角。氛围亲密而安静。\\n\\n\",\"场景道具\":\"14,0\"},{\"提示词\":\"静态构图描述：全景，人物站立在书柜与桌子之间，踮起脚尖将故事本插回书柜高处的一个空格中，左臂伸直推送书本，右臂自然下垂。身体右转但面部完全转向镜头，呈现一个舒展的回眸姿态。眼神清澈坦然，仿佛完成了一场仪式，神情平静中带有满足。整个书房空间完整呈现：书桌、台灯、留声机、窗帘、地毯、窗户，所有元素和谐共存。阳光已转为更浓郁的琥珀色，长长的影子投射在地毯上，书房笼罩在黄昏的宁静中。画面具有电影结尾的定格感。\\n\\n\",\"场景道具\":\"14,0\"},{\"提示词\":\"静态构图描述：中近景，人物站在留声机旁，右手食指轻点在静止的黑胶唱片中央标签上，左手扶在桌沿。身体前倾但面部抬起朝向镜头，眼神深邃而温柔，嘴角绽放一个完整的、释然的微笑，这是全片中最温暖的表情。翡翠台灯的光和窗外黄昏余晖在人物脸上交汇，形成冷暖交织的肤色质感。留声机的铜喇叭上映出人物缩小而变形的倒影。空气中尘埃几乎静止，氛围达到最静谧的高潮。画面色彩饱和略提升，金色的暖调贯穿始终。\\n\\n\",\"场景道具\":\"0,14\"},{\"提示词\":\"静态构图描述：全景，人物站在书房中央，身后是书柜、书桌、留声机，面前是镜头。站姿放松自然，双手垂在身侧，面部完全朝向镜头，眼神宁静如深潭，嘴角仍挂着那个释然的微笑。台灯是此刻唯一的光源，在人物身上投下温暖的光晕，身体一侧被照亮，另一侧融入柔和的暗影中，明暗交界线柔和。整个书房在暗影中呈现深沉的木色，只有人物和台灯光是画面的暖色焦点。故事本静静立在书架的格子里，留声机静止。画面如同一幅古典油画，充满寂静的故事感。气氛归于圆满的宁静。\\n\\n\",\"场景道具\":\"0,14\"}]"}]},{"id":50,"type":"PrimitiveStringMultiline","pos":[-2260,-680],"size":[680,290],"flags":{"collapsed":true},"order":7,"mode":0,"inputs":[{"label":"value","localized_name":"值","name":"value","type":"STRING","widget":{"name":"value"},"link":null}],"outputs":[{"label":"STRING","localized_name":"字符串","name":"STRING","type":"STRING","links":[394]}],"title":"通用提示词","properties":{"cnr_id":"comfy-core","ver":"0.18.1","Node name for S&R":"PrimitiveStringMultiline","ue_properties":{"widget_ue_connectable":{},"input_ue_unconnectable":{},"version":"7.8"}},"widgets_values":["上装：一件燕麦色的园领宽松羊绒针织衫，面料柔软垂坠，袖口微微卷起露出手腕，版型慵懒但不松垮，暖调米色上带有极细的深驼色杂线纹理。\n\n下装：深棕色高腰阔腿西装长裤，垂感极佳的羊毛混纺面料，裤脚自然盖过脚面，走动时呈现流畅的褶皱弧线。\n\n鞋子：暗棕红色的复古圆头乐福鞋，皮质柔软哑光，搭配同色系薄针织短袜。\n\n配饰：左手腕一只极细的哑光金色圆环手镯，右手中指一枚简约的古铜色素圈戒指，无其他夸张饰品。\n\n神态气质：整体呈现温柔中带疏离、沉静中透出故事感的复古文艺气质，眼神仿佛能看穿时光，嘴角若有似无的浅笑，贴合歌曲对“故事虚实的哲思”。"]},{"id":143,"type":"FxAiCharacterBatchLoad","pos":[-2250,-330],"size":[210,150],"flags":{},"order":13,"mode":0,"inputs":[{"localized_name":"图片文件夹路径","name":"图片文件夹路径","type":"STRING","widget":{"na